@model CheckoutViewModel
@{ ViewData["Title"] = "Checkout"; }

<h2 class="mb-3">Checkout</h2>

<div class="row">
    <div class="col-md-7">
        <ul class="list-group mb-3">
            @foreach (var item in Model.Items)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@item.ItemName x @item.Quantity</span>
                    <span>RM @item.Subtotal.ToString("0.00")</span>
                </li>
            }
            <li class="list-group-item d-flex justify-content-between fw-bold">
                <span>Subtotal</span>
                <span>RM @Model.Subtotal.ToString("0.00")</span>
            </li>
        </ul>
    </div>

    <div class="col-md-5">
        <form asp-action="Checkout" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="TableId" class="form-label">Select a Table</label>
                <select asp-for="TableId" class="form-select" asp-items="@(new SelectList((IEnumerable<DiningTable>)ViewBag.Tables, "TableId", "TableNumber"))">
                    <option value="">-- Select Table --</option>
                </select>
                <span asp-validation-for="TableId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" placeholder="e.g. no chili, allergy notes"></textarea>
            </div>

            <hr />

            <div class="mb-3">
                <label asp-for="VoucherCode" class="form-label">Voucher / Discount Code</label>
                <input asp-for="VoucherCode" class="form-control" placeholder="e.g. WELCOME5" style="text-transform:uppercase" />
                <span asp-validation-for="VoucherCode" class="text-danger"></span>
            </div>

            <div class="mb-3 border rounded p-3 bg-light">
                <div class="form-check mb-2">
                    <input asp-for="UsePoints" class="form-check-input" id="usePointsCheck" />
                    <label asp-for="UsePoints" class="form-check-label">Redeem Points (You have @Model.AvailablePoints points, 100 pts = RM5)</label>
                </div>
                <input asp-for="PointsToRedeem" class="form-control" type="number" min="0" max="@Model.AvailablePoints" />
                <span asp-validation-for="PointsToRedeem" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PaymentMethod" class="form-label"></label>
                <select asp-for="PaymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success w-100">Place Order</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
