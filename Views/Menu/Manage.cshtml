@model List<MenuItem>
@{ ViewData["Title"] = "Manage Menu"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Manage Menu Items</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Menu Item</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price (RM)</th>
            <th>Available</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ItemName</td>
                <td>@item.Category?.CategoryName</td>
                <td>@item.Price.ToString("0.00")</td>
                <td>
                    @if (item.IsAvailable)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MenuItemId" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@item.MenuItemId" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this menu item?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
