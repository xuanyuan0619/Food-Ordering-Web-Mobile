@{
    ViewData["Title"] = "Admin Dashboard";
    bool isSample = (bool)ViewBag.IsSampleData;
    var trendLabelsJson = System.Text.Json.JsonSerializer.Serialize((List<string>)ViewBag.TrendLabels);
    var trendCountsJson = System.Text.Json.JsonSerializer.Serialize((List<int>)ViewBag.TrendCounts);
}

<h2 class="mb-4">Admin Dashboard</h2>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card text-center p-3">
            <h5>Total Orders</h5>
            <p class="display-6">@ViewBag.TotalOrders</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3">
            <h5>Pending Orders</h5>
            <p class="display-6">@ViewBag.PendingOrders</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3">
            <h5>Total Users</h5>
            <p class="display-6">@ViewBag.TotalUsers</p>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-5 mb-3">
    <h4 class="mb-0">Order Analytics</h4>
    @if (isSample)
    {
        <span class="badge bg-secondary">Sample Data - no orders yet</span>
    }
</div>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card p-3">
            <h6>Order Trend (Last 7 Days)</h6>
            <canvas id="trendChart" height="180"></canvas>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card p-3">
            <h6>Order Status Distribution</h6>
            <canvas id="statusChart" height="180"></canvas>
        </div>
    </div>
</div>

<div class="mt-4 d-flex gap-2">
    <a asp-controller="Menu" asp-action="Manage" class="btn btn-outline-primary">Manage Menu</a>
    <a asp-action="Staff" class="btn btn-outline-primary">Staff Accounts</a>
    <a asp-action="CreateStaff" class="btn btn-outline-primary">Add Staff</a>
    <a asp-controller="Kitchen" asp-action="Report" class="btn btn-outline-primary">View Reports</a>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const trendLabels = @Html.Raw(trendLabelsJson);
        const trendCounts = @Html.Raw(trendCountsJson);

        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [{
                    label: 'Orders',
                    data: trendCounts,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13,110,253,0.15)',
                    tension: 0.3,
                    fill: true
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: ['Pending', 'Completed', 'Cancelled'],
                datasets: [{
                    data: [@ViewBag.StatusPending, @ViewBag.StatusCompleted, @ViewBag.StatusCancelled],
                    backgroundColor: ['#ffc107', '#198754', '#dc3545']
                }]
            },
            options: {
                plugins: { legend: { position: 'bottom' } }
            }
        });
    </script>
}
