@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center py-5">
    <h1 class="display-5">Welcome to the Food Ordering System</h1>
    <p class="lead">Order your favourite dishes for in-house dining, or reserve a table ahead of time.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg me-2">Login</a>
    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">Create an Account</a>
</div>
